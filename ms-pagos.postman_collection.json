{
  "info": {
    "_postman_id": "32db6b31-8a40-4baf-9b84-526b81eb0dea",
    "name": "ms-pagos",
    "description": "Colección completa del Microservicio de Pagos Online con IZIPAY. Incluye endpoints para configuración, generación de token, procesamiento de pagos, respuestas y rechazos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Configuración IZIPAY",
      "item": [
        {
          "name": "Registrar Configuración IZIPAY",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"merchantCode\": \"12345678\",\n    \"passwordIzipay\": \"testpassword_DEMOPRIVATEKEY123\",\n    \"publicKey\": \"testpublickey_DEMOPUBLICKEY456\",\n    \"hmacSha256\": \"testHmacSha256_DEMOHMAC789\",\n    \"urlPago\": \"https://api.micuentaweb.pe/api-payment/V4/Charge/CreatePayment\",\n    \"urlToken\": \"https://api.micuentaweb.pe/api-payment/V4/Charge/CreateToken\",\n    \"moneda\": \"PEN\",\n    \"activo\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:8080/api/configuracion",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "configuracion"]
            },
            "description": "Registra los datos de configuración necesarios para conectarse con IZIPAY: merchant code, contraseña, llaves de seguridad y URLs."
          },
          "response": []
        },
        {
          "name": "Generar Token IZIPAY (por ID)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/configuracion/1/token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "configuracion", "1", "token"]
            },
            "description": "Genera el token de comunicación Base64 (merchantCode:password) usando la configuración con ID 1. Este token se usa para autenticar llamadas a IZIPAY."
          },
          "response": []
        },
        {
          "name": "Generar Token IZIPAY (configuración activa)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/configuracion/token/activo",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "configuracion", "token", "activo"]
            },
            "description": "Genera el token de comunicación usando la configuración IZIPAY que esté marcada como activa."
          },
          "response": []
        },
        {
          "name": "Listar Configuraciones IZIPAY",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/configuracion",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "configuracion"]
            },
            "description": "Retorna la lista de todas las configuraciones IZIPAY registradas."
          },
          "response": []
        },
        {
          "name": "Obtener Configuración por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/configuracion/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "configuracion", "1"]
            },
            "description": "Retorna los datos de una configuración IZIPAY específica por su ID."
          },
          "response": []
        },
        {
          "name": "Actualizar Configuración IZIPAY",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"merchantCode\": \"12345678\",\n    \"passwordIzipay\": \"nuevopassword_ACTUALIZADO123\",\n    \"publicKey\": \"nuevapublickey_ACTUALIZADA456\",\n    \"hmacSha256\": \"nuevoHmac_ACTUALIZADO789\",\n    \"urlPago\": \"https://api.micuentaweb.pe/api-payment/V4/Charge/CreatePayment\",\n    \"urlToken\": \"https://api.micuentaweb.pe/api-payment/V4/Charge/CreateToken\",\n    \"moneda\": \"PEN\",\n    \"activo\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:8080/api/configuracion/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "configuracion", "1"]
            },
            "description": "Actualiza los datos de una configuración IZIPAY existente."
          },
          "response": []
        }
      ]
    },
    {
